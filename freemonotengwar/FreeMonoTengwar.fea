# Script and language coverage
languagesystem DFLT dflt;
languagesystem latn dflt;

@tehtarAbove = [atehta yatehta tixe etehta etehta_etehta otehta utehta
otehta_otehta utehta_utehta nengwetehta watehta ytehta etehtanuquerna
yantatehta atehtanuquerna];

@rightTengwar = [tinco parma ando umbar suule formen anto ampa oore vala
suuletinco formemparma antando ampumbar yanta uure telco TINCO PARMA ANDO UMBAR
SUULE FORMEN ANTO AMPA OORE VALA SUULETINCO FORMEMPARMA ANTANDO AMPUMBAR YANTA
UURE TELCO];

# Class definitions

lookup tengwar_ligatures_ignoring_tehtar {
    lookupflag IgnoreMarks;

    # Ligatures proper
    sub \hwesta \zwj \tinco by \hwesta_tinco;
    sub \silme \zwj \aha by \silme_aha;

    # Tengwa and unutehta combinations
    sub \lambe \putta \putta by \lambe_unuyatehta;
    sub \lambe \andatehta by \lambe_andatehta;
    sub \lambe \putta by \lambe_putta;
    sub \lambe \unuyatehta by \lambe_unuyatehta;
    sub \alda \andatehta by \alda_andatehta;
    sub \lambenuquerna \andatehta by \lambenuquerna_andatehta;

    # Combining sarince ligatures
    sub \tinco \combiningsarince by \tinco_combiningsarince;
    sub \parma \combiningsarince by \parma_combiningsarince;
    sub \calma \combiningsarince by \calma_combiningsarince;
    sub \quesse \combiningsarince by \quesse_combiningsarince;
    sub \ando \combiningsarince by \ando_combiningsarince;
    sub \umbar \combiningsarince by \umbar_combiningsarince;
    sub \suule \combiningsarince by \suule_combiningsarince;
    sub \formen \combiningsarince by \formen_combiningsarince;
    sub \aha \combiningsarince by \aha_combiningsarince;
    sub \hwesta \combiningsarince by \hwesta_combiningsarince;
    sub \anto \combiningsarince by \anto_combiningsarince;
    sub \ampa \combiningsarince by \ampa_combiningsarince;
    sub \nuumen \combiningsarince by \nuumen_combiningsarince;
    sub \malta \combiningsarince by \malta_combiningsarince;
    sub \oore \combiningsarince by \oore_combiningsarince;
    sub \vala \combiningsarince by \vala_combiningsarince;
    sub \anna \combiningsarince by \anna_combiningsarince;
    sub \vilya \combiningsarince by \vilya_combiningsarince;
    sub \suuletinco \combiningsarince by \suuletinco_combiningsarince;
    sub \formemparma \combiningsarince by \formemparma_combiningsarince;
    sub \ahacalma \combiningsarince by \ahacalma_combiningsarince;
    sub \hwestaquesse \combiningsarince by \hwestaquesse_combiningsarince;
    sub \antando \combiningsarince by \antando_combiningsarince;
    sub \ampumbar \combiningsarince by \ampumbar_combiningsarince;
    sub \yanta \combiningsarince by \yanta_combiningsarince;
    sub \uure \combiningsarince by \uure_combiningsarince;
    sub \telco \combiningsarince by \telco_combiningsarince;
} tengwar_ligatures_ignoring_tehtar;

lookup tengwar_ligatures_regarding_tehtar {
    lookupflag 0;

    # ZWJ magic
    sub \zwj \andatelco by \thinnas;

    # Double tehta
    sub \tixe \tixe by \yatehta;
    sub \putta \putta by \unuyatehta;
    sub \etehta \etehta by \etehta_etehta;
    sub \unuetehta \unuetehta by \unuetehta_unuetehta;
    sub \otehta \otehta by \otehta_otehta;
    sub \utehta \utehta by \utehta_utehta;
    sub \etehtanuquerna \etehtanuquerna by \etehtanuquerna_etehtanuquerna;

    # Tixe/putta combinations
    sub \tixe \otehta by \otehta_tixe;
    sub \otehta \tixe by \otehta_tixe;
    sub \tixe \utehta by \utehta_tixe;
    sub \utehta \tixe by \utehta_tixe;
    sub \tixe \etehta by \tixe_etehta;
    sub \putta \thinnas by \thinnas_putta;
    sub \thinnas \putta by \thinnas_putta;
} tengwar_ligatures_regarding_tehtar;

feature liga {
    substitute \watehta' [@tehtarAbove] by \watehta.alt;

    lookup tengwar_ligatures_ignoring_tehtar;
    lookup tengwar_ligatures_regarding_tehtar;

    lookupflag IgnoreMarks;
    substitute [@rightTengwar] \combiningsarince' by \combiningsarince.2;
} liga;
